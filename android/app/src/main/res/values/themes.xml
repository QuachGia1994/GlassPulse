<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassPulse" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/glass_background</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:navigationBarColor">@color/glass_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.GlassPulse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/glass_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_glass_pulse_foreground</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.GlassPulse</item>
    </style>
</resources>
