    "settings.highContrast.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raises text, ring and border contrast with non-color state cues."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng tương phản chữ, vòng, viền và thêm dấu hiệu trạng thái không dựa vào màu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字・リング・枠のコントラストを上げ、色によらない状態表示を追加します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高文字、圆环与边框对比度，并加入非颜色状态提示。"
          }
        }
      }
    },
    "settings.highContrast.label": {
      "localizations": {
        "en": {
