    "settings.reduceMotion.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disables splash pulsing and ring breathing. Gameplay timing is unchanged."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt nhấp nháy splash và nhịp thả vòng. Thời gian chơi không đổi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スプラッシュの脈動とリングの呼吸を無効化します。ゲームプレイのタイミングは変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭启动画面脉动与圆环呼吸。游戏计时不受影响。"
          }
        }
      }
    },
