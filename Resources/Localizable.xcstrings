    "settings.language.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies immediately and persists across launches."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng ngay và được lưu cho các lần mở sau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに適用され、起動後も保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效并在启动后保持。"
          }
        }
