      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Direction: counterclockwise" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "方向：反時計回り" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hướng: ngược chiều" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "方向：逆时针" } }
      }
    },
    "game.input.hint.over" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use Retry or Choose Mode. Background taps do nothing." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「もう一度」または「モードを選ぶ」を使用してください。背景タップは無効です。" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dùng Chơi lại hoặc Chọn mode. Chạm nền không có tác dụng." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请使用“再玩一次”或“选择模式”。点击背景不会触发操作。" } }
      }
    },
    "game.input.hint.paused" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use the Resume button to continue. Background taps do nothing." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "続けるには再開ボタンを使用してください。背景タップは無効です。" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dùng nút Tiếp tục để chơi. Chạm nền không có tác dụng." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请使用继续按钮。点击背景不会触发操作。" } }
      }
    },
    "game.input.hint.playing" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Double-tap to reverse direction once." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ダブルタップで進行方向を1回反転します。" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chạm hai lần bằng VoiceOver để đảo chiều đúng một lần." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "双击一次以反转方向。" } }
      }
    },
    "game.input.hint.start" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Double-tap to start the selected run." } },
