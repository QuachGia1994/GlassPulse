    "game.input.direction.clockwise" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Direction: clockwise" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "方向：時計回り" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hướng: thuận chiều" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "方向：顺时针" } }
